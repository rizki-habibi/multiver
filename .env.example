# Authentication
JWT_SECRET=
AUTH_SECRET=
AUTH_COOKIE_SECURE=true

# GitHub OAuth — satu-satunya login dashboard
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-domain.example/api/auth/github/callback
ADMIN_GITHUB_ID=150777189
ALLOW_GITHUB_USERS=false

# Provider/API key encryption. Use 32 random bytes encoded as 64 hex characters.
ENCRYPTION_KEY=

# Production database — Supabase PostgreSQL
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional reverse-proxy trust. Enable only when your proxy overwrites these headers.
TRUST_PROXY=false
