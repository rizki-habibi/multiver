# Authentication
JWT_SECRET=
AUTH_SECRET=
INITIAL_PASSWORD=
AUTH_COOKIE_SECURE=true

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-domain.example/api/auth/github/callback
ADMIN_GITHUB_ID=
# Keep false until legacy resources have been migrated to per-user ownership.
ALLOW_GITHUB_USERS=false

# Provider/API key encryption. Use 32 random bytes encoded as 64 hex characters.
ENCRYPTION_KEY=

# Production database. The current legacy DB layer is SQLite-oriented;
# do not assume local filesystem persistence on Vercel.
DATABASE_URL=

# Optional reverse-proxy trust. Enable only when your proxy overwrites these headers.
TRUST_PROXY=false

# Optional runtime data directory for self-hosted deployments.
DATA_DIR=
