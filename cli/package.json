{
  "name": "multiver",
  "version": "6.2.0",
  "description": "Multiver CLI - Advanced Multi-AI Fusion Router Manager",
  "bin": {
    "multiver": "./cli.js"
  },
  "files": [
    "cli.js",
    "src",
    "hooks",
    "app",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "nodemon -I --watch cli.js --watch src --watch hooks --ext js,json cli.js",
    "build": "node scripts/build-cli.js",
    "link:global": "node link-global.js",
    "pack:cli": "npm run build && npm pack --pack-destination ..",
    "publish:cli": "npm run build && npm publish",
    "postinstall": "node hooks/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "multiver",
    "ai-proxy",
    "fusion-router",
    "llm-gateway",
    "multi-provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizki/multiver.git"
  },
  "author": "Rizki",
  "homepage": "https://github.com/rizki/multiver#readme",
  "bugs": {
    "url": "https://github.com/rizki/multiver/issues"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "nodemon": "^3.1.14"
  }
}
